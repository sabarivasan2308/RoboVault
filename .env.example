# ==========================================
# RoboVault Environment Configuration Template
# Copy this to .env before starting the services
# ==========================================

# Port mappings
FRONTEND_PORT=3000
BACKEND_PORT=8080
MONGO_PORT=27017

# MongoDB Configuration
MONGO_INITDB_DATABASE=robovault
MONGO_URI=mongodb://mongodb:27017/robovault

# Backend Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api

