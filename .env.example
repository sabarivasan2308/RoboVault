# ==========================================
# RoboVault Environment Configuration Template
# Copy this to .env before starting the services
# ==========================================

# Port mappings
# Note: If Tier A standalone server is active on port 3000, set FRONTEND_PORT=3001 to prevent port collisions
FRONTEND_PORT=3000
BACKEND_PORT=8080
MONGO_PORT=27017

# MongoDB Configuration (Official Image Environment Settings)
MONGO_INITDB_ROOT_USERNAME=robovault_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_secure_mongodb_password
MONGO_INITDB_DATABASE=robovault
MONGO_URI=mongodb://robovault_admin:replace_with_secure_mongodb_password@mongodb:27017/robovault?authSource=admin

# Backend Configuration & Security
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Mandatory JWT secret (minimum 256 bits / 32 characters for HMAC-SHA signing)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Frontend Configuration
VITE_API_BASE_URL=/api
